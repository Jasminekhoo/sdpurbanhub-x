Stop-Process -Id 16268 -Force# LIVIN / NightSafe Loop — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ─── Google Maps ──────────────────────────────────────────────────────────────
# Required for the Google Maps township view used in the Security and Property
# dashboards, and in the resident NightPath journey map.
#
# Steps to obtain a key:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create a new API key (or use an existing one).
#   3. Enable the "Maps JavaScript API" at:
#      https://console.cloud.google.com/apis/library/maps-backend.googleapis.com
#   4. (Optional) Restrict the key to your domain or localhost for security.
#
# If this key is missing, invalid, or the Maps JavaScript API is not enabled,
# the app falls back to the built-in schematic map — no crash.
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
